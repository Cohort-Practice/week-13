generator client {
  provider = "prisma-client-js"
   binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  name     String?     
  password String
  posts    Post[]
}

model Post {
  id          String     @id @default(uuid())
  tittle      String     
  content     String     
  published   Boolean    @default(false)
  author      User       @relation(fields: [authorId] , references: [id])
  authorId    String
}
